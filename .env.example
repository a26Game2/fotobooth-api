NODE_ENV=development
PORT=3000
API_PORT=3000
RUN_MIGRATIONS=true
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_PUBLISHABLE_KEY="YOUR_SUPABASE_PUBLISHABLE_KEY"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"
SUPABASE_SERVICE_COVERS_BUCKET="service-covers"
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_URL_ENCODED_PASSWORD@YOUR_REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_URL_ENCODED_PASSWORD@YOUR_REGION.pooler.supabase.com:5432/postgres"
ADMIN_API_KEY=change-this-before-production
UPLOAD_DIR=storage/uploads
REDIS_URL="redis://127.0.0.1:16379"
CACHE_TTL_SECONDS=300
AUDIT_LOG_CRON="* * * * *"
AUDIT_LOG_BATCH_SIZE=100
JWT_SECRET="generate-a-long-random-secret"
JWT_EXPIRES_IN="8h"
ADMIN_EMAIL="admin@tred.vn"
ADMIN_PASSWORD="change-this-strong-password"
SWAGGER_USERNAME="swagger-admin"
SWAGGER_PASSWORD="change-this-swagger-password"
